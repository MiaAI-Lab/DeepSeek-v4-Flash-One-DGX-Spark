# ── Runtime / generated artifacts ─────────────────────────────────────────
# Weights, K64 draft, JetStack caches (downloaded/built at runtime; ~100+ GiB)
data/
cache/
hf-hub/   # local HuggingFace cache root (default HF_CACHE; see start.sh)

# Generated by start.sh / start-180k.sh (do not commit; regenerate on run)
compose.yml
compose-180k.yaml

# Local secrets (HF_TOKEN etc.) — start.sh reads ${HF_TOKEN:-}
.env
.env.*


# ── Docs / tooling (not required for the setup to run) ───────────────────
PLAN.md
improve-context.md
sweep-kv.sh
sweep-kv.log
*.log

# ── Unused copies of in-image recipe scripts ─────────────────────────────
# These live in the runtime image at /opt/recipe/scripts/; these local
# copies are not bind-mounted by start.sh and are kept only as references.
image-patch/acceptance_c1.py
image-patch/build_dspark_draft.py
image-patch/selftest.py
image-patch/verify_tp1_manifest.py

# ── Editor / OS noise ────────────────────────────────────────────────────
.DS_Store
*.swp
*~

# Python bytecode
__pycache__/
*.pyc

# Internal ops docs — stay local, NOT for the git repo
HANDOFF.md
NVFP4-PREFILL-POSTMORTEM.md
